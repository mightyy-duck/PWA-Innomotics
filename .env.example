# Runtime only (App Service Application Settings). No secrets needed — auth is Easy Auth.
# Easy Auth cookieExpiration is only a backstop: set it slightly LONGER than SESSION_MINUTES (e.g. 00:16:00).

# Session limit enforced by the app (middleware.ts) and shown in the countdown.
SESSION_MINUTES=15
# Random 32+ byte string; signs the pwa_session login stamp.
SESSION_SECRET=
